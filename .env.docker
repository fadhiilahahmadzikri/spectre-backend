# ==============================================================================
# Spectre — Docker Environment (pre-configured, no manual edits needed)
# Used by: docker compose --env-file .env.docker up
# ==============================================================================

APP_NAME=spectre
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_RETENTION=7 days
LOG_SLOW_QUERY_MS=500
SECRET_KEY=docker_dev_secret_key_not_for_production_use

API_HOST=0.0.0.0
API_PORT=8000

# --- Database (matches docker-compose postgres service) ---
DATABASE_URL=postgresql+asyncpg://postgres:spectre_dev_pass@postgres:5432/spectre
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis (matches docker-compose redis service) ---
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=spectre:
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_SECRET_KEY=docker_dev_jwt_secret_64_characters_long_enough_for_hs256_signing
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
ENCRYPTION_KEY=ZG9ja2VyX2Rldl9lbmNyeXB0aW9uX2tleV8zMmI=
BCRYPT_COST=4
API_KEY_LENGTH=48

# --- SMTP (MailHog in Docker — catches all emails) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@spectre.local
SMTP_FROM_NAME=Spectre Auth

# --- Google OAuth (disabled in Docker dev) ---
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# --- TOTP ---
TOTP_ISSUER_NAME=Spectre

# --- ML ---
MODEL_PATH=artifact/best_model.keras
MODEL_IMG_SIZE=256
MODEL_USE_TTA=false
INFERENCE_DEVICE=cpu

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_FACE_OPERATIONS=60/minute

# --- Webhook ---
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=4

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8001
CORS_ALLOW_CREDENTIALS=true

# --- Face Matching ---
SIMILARITY_THRESHOLD=0.40
LIVENESS_THRESHOLD=0.5
