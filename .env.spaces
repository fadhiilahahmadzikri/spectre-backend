
APP_NAME=spectre
APP_ENV=production
DEBUG=true
LOG_LEVEL=INFO
LOG_RETENTION=7 days
LOG_SLOW_QUERY_MS=500
SECRET_KEY=hf-spaces-change-this-via-secrets
ALLOWED_HOSTS=*
STATIC_API_KEY=spk_d602c7bc949464b18c0fafc1c3c5d4f048bf2a524acad217

# --- Server ---
API_HOST=0.0.0.0
API_PORT=7860
API_WORKERS=1
API_RELOAD=false

# --- Database (internal PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres.rgnyrswxydfuqldeeqsg:ZikriSpectre2026%21%23@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis (internal) ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=spectre:

# --- Celery (internal Redis) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=hf-spaces-change-this-via-secrets
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security / Encryption ---
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
BCRYPT_COST=12
API_KEY_LENGTH=48



# --- Google OAuth (set real values via HF Secrets) ---
GOOGLE_CLIENT_ID=set-via-hf-secrets
GOOGLE_CLIENT_SECRET=set-via-hf-secrets
GOOGLE_REDIRECT_URI=https://thewhitenigs-spectre-backend.hf.space/api/v1/auth/oauth/google/callback
OAUTH_FRONTEND_REDIRECT=https://spectre-fr-tester-flight.vercel.app

# --- TOTP ---
TOTP_ISSUER_NAME=Spectre

# --- ML / Inference ---
MODEL_PATH=/app/artifact/best_model.keras
MODEL_IMG_SIZE=256
MODEL_USE_TTA=false
INFERENCE_DEVICE=cpu

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_FACE_OPERATIONS=30/minute

# --- Webhook ---
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=4
WEBHOOK_RETRY_BACKOFF_BASE=30

# --- CORS (allow HF Spaces iframe + any origin for API access) ---
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# --- Face Matching ---
SIMILARITY_THRESHOLD=0.75
LIVENESS_THRESHOLD=0.5
