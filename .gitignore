# ==============================================================================
# Spectre Monorepo Root — .gitignore
# Root-level git tracks the overall workspace structure.
# Each sub-project has its own git repository.
# ==============================================================================

# ── Sub-projects with their own git (DO NOT track) ───────────────────────
spectre-backend/
spectre-frontend/
spectre-snap/
example-client/
test-snap-e2e/
test-snap-login/

# ── Experiments & Standalone tools ───────────────────────────────────────
poc/
kaggle/
multimodel/
conductor/

# ── Dev tooling ──────────────────────────────────────────────────────────
.agents/
.antigravitycli/
.cache/
.conductor/
.kiro/

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
