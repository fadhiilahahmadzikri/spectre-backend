# ==============================================================================
# Spectre Monorepo Root — .gitignore
# Root-level git tracks the overall workspace structure.
# Each sub-project has its own git repository.
# ==============================================================================

# ── Tooling & Cache ──────────────────────────────────────────────────────
.agents/
.antigravitycli/
.cache/
.conductor/
.kiro/
.vercel/
.turbo/
.next/
.nuxt/
.pytest_cache/
.ruff_cache/
.temp/
.ignored/

# ── OS / IDE ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ── Node / Build Outputs ─────────────────────────────────────────────────
node_modules/
dist/
build/
out/
.npmrc

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# ── Environment / Secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
