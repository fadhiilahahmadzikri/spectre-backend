# ==============================================================================
# Spectre Frontend — .gitignore
# ==============================================================================

# ── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/


# ── Build artifacts ─────────────────────────────────────────────────────
dist/
dist-ssr/
*.local
.tsbuildinfo

# ── Testing & Coverage ──────────────────────────────────────────────────
.coverage
coverage/
.pytest_cache/
.vitest/
.vitest-results/

# ── IDE & Editor ────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
*~

# ── Environment files ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.docker

# ── Caching ─────────────────────────────────────────────────────────────
.cache/
.turbo/
.next/

# ── OS ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Deployment ──────────────────────────────────────────────────────────
.vercel/

# ── Development tools ───────────────────────────────────────────────────
.agent/
.agents/
graphify-out/
.vercel
.env*.local
