# Environment variables for Spectre Snap Login

# Backend URL where Spectre API is running
VITE_SPECTRE_BASE_URL=https://thewhitenigs-spectre-backend.hf.space

# API Key for Spectre authentication
VITE_SPECTRE_API_KEY=

# Optional external_user_id used when the mock email field is empty.
VITE_SPECTRE_TEST_USER_ID=spectre-test-user

# Webhook receiver base URL (no trailing path)
# Local only (backend must run on same machine): http://localhost:8787
# HF backend + Cloudflare Tunnel: https://spectre-webhook.autovoid.cyou
VITE_WEBHOOK_RECEIVER_URL=http://localhost:8787

# Receiver-only secret used by npm run receiver to verify X-Spectre-Signature.
# This must match the webhook secret generated for the Spectre application.
SPECTRE_WEBHOOK_SECRET=
