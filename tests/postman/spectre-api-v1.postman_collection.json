{
  "info": {
    "name": "Spectre API v1",
    "_postman_id": "spectre-api-v1-collection",
    "description": "API validation suite for Spectre. Works against local and HF Spaces.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "auth_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "app_id", "value": "" },
    { "key": "api_key", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health — Component status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => { pm.expect(pm.response.headers.get('content-type')).to.include('json'); });",
                  "pm.test('Has components', () => pm.expect(pm.response.json()).to.have.property('components'));",
                  "pm.test('Has service name', () => pm.expect(pm.response.json().service).to.eql('spectre-api'));",
                  "pm.test('Database healthy', () => pm.expect(pm.response.json().components.database).to.eql('healthy'));",
                  "pm.test('Redis healthy', () => pm.expect(pm.response.json().components.redis).to.eql('healthy'));",
                  "pm.test('ML model loaded', () => pm.expect(pm.response.json().components.ml_model).to.eql('loaded'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth — Validation",
      "item": [
        {
          "name": "POST /auth/register — Missing email (422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"password\": \"Test1234!\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Has detail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register — Missing password (422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"test@example.com\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login — Empty body (422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth — Protection",
      "item": [
        {
          "name": "GET /applications — No auth (401/422)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects without auth', () => pm.expect([401, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /applications — No auth (401/422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/applications",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\": \"Test App\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects without auth', () => pm.expect([401, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /sessions — No auth (401/422)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/sessions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects without auth', () => pm.expect([401, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Face Ops — API Key Required",
      "item": [
        {
          "name": "POST /faces/register — No API key (401/422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/faces/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"external_user_id\": \"usr_test\", \"image\": \"dGVzdA==\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects without API key', () => pm.expect([401, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /faces/authenticate — No API key (401/422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/faces/authenticate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"external_user_id\": \"usr_test\", \"image\": \"dGVzdA==\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects without API key', () => pm.expect([401, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Face Ops — With API Key",
      "item": [
        {
          "name": "POST /faces/register — Valid key, invalid image",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/faces/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"external_user_id\": \"newman_test_user\", \"image\": \"bm90X2FfcmVhbF9pbWFnZQ==\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API key accepted (not 401)', () => pm.expect(pm.response.code).to.not.eql(401));",
                  "pm.test('Rejects bad image (400/422/500)', () => pm.expect([400, 422, 500]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /faces — List with API key",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/faces",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns profiles list', () => { const body = pm.response.json(); pm.expect(body).to.have.any.keys('data', 'profiles'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
